# Vigil — environment configuration
# Copy to .env and fill in your keys:  cp .env.example .env

# ── LLM (required for agent analysis) ─────────────────────────────────────
# Default provider is AIML API (https://aimlapi.com — free tier available).
AIML_API_KEY=your-aiml-api-key

# Or use ANY OpenAI-compatible endpoint instead (overrides AIML defaults):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...

# Optional: force one model for all 8 agents (default: per-agent Claude models)
# VIGIL_MODEL=claude-sonnet-4-6

# ── News (required for live headlines; yfinance needs no key) ─────────────
# Free tier: 100 requests/day — https://newsapi.org/register
NEWSAPI_KEY=your-newsapi-key

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3000
# SECRET_KEY=generate-a-random-string-for-session-signing
