# .streamlit/secrets.toml — Vigil API credentials
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: Copy this file to .streamlit/secrets.toml (local) or paste these
# key=value pairs into the Streamlit Cloud "Secrets" panel (Settings → Secrets).
# NEVER commit secrets.toml to version control — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# AI/ML API — powers all 8 Vigil agents (OpenAI-compatible endpoint)
# Get your key at: https://aimlapi.com
AIML_API_KEY = "your-aiml-api-key-here"

# NewsAPI.org — live financial headlines (free tier: 100 req/day)
# Get your key at: https://newsapi.org/register
NEWSAPI_KEY = "your-newsapi-org-key-here"

# yfinance — no API key required (uses Yahoo Finance public feeds)
